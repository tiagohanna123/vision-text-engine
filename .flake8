[flake8]
max-line-length = 100
extend-ignore = E203, E501, W503
exclude = .git, __pycache__, venv, .venv, build, dist, *.egg-info
per-file-ignores =
    __init__.py: F401
    tests/*.py: D

# Note: Ruff é o linter principal. Este arquivo existe para compatibilidade
# com ferramentas que ainda usam flake8.
